# FRA AI Decision Support System - Environment Configuration
# Copy this file to .env and update values as needed

# API Configuration
API_BASE_URL=http://localhost:8000

# -------------------------------------------------------------
# Optional Free LLM Providers for Anomaly Summary Generation
# The system works completely out-of-the-box with rule-based AI logic
# if no key is provided.
# -------------------------------------------------------------
# Option 1: Free Groq API (e.g. Llama-3.1-8B)
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_your_free_groq_api_key_here

# Option 2: Free Google Gemini API
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIzaSy_your_free_gemini_key_here

# Option 3: Local Free Ollama (no key needed)
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434/api/generate

# Database Configuration (defaults to database/fra.db)
DATABASE_URL=sqlite:///database/fra.db
